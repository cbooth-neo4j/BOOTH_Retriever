# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agentic Text2Cypher Model (optional - defaults to OPENAI_CHAT_MODEL)
# Use a more capable model for complex graph reasoning
AGENTIC_TEXT2CYPHER_MODEL=gpt-4o

# Refinement Agent Model (REQUIRED)
# Used for consolidating multi-step queries into parameterized templates
REFINEMENT_AGENT_MODEL=gpt-4o

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# BOOTH Settings
SIMILARITY_THRESHOLD=0.90
