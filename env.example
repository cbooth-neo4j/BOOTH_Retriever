# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# BOOTH Settings
SIMILARITY_THRESHOLD=0.90
MAX_CYPHER_RETRIES=3

# Iterative Refinement for Text2Cypher
# Verifier types: RULE_BASED, CYVER, EXECUTION_BASED, LLM_BASED (comma-separated)
CYPHER_VERIFIERS=RULE_BASED,EXECUTION_BASED

# Corrector types: RULE_BASED, LLM_BASED (comma-separated)
CYPHER_CORRECTORS=RULE_BASED,LLM_BASED

# Use metadata from verification in correction process
USE_VERIFICATION_METADATA=true

