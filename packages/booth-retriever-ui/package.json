{
  "name": "booth-retriever-ui",
  "version": "0.0.1",
  "description": "Static web UI for the BOOTH Retriever curation workflow. Vanilla HTML + CSS + TypeScript, built with Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/ui": "^2.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@neo4j-nvl/base": "^1.2.0",
    "@neo4j-nvl/interaction-handlers": "^1.2.0"
  }
}
